// PTX ISA 9.4 §8.10.6: message passing through fence.sys release/acquire patterns.
.global data;
.global flag;

d0.b0.t0 {
  st.weak [data], 1;
  fence.$0.$1;
  st.relaxed.$1 [flag], 1;
}

d0.b$2.t0 {
  ld.relaxed.$1 r0, [flag];
  fence.$0.$1;
  ld.weak r1, [data];
}

$3 (r0 != 1 || r1 == 1) as mp;

$$
acq_rel | sys | 1 | assert
acq_rel | gpu | 1 | assert
acq_rel | cta | 1 | check
acq_rel | cta | 0 | assert
sc      | gpu | 1 | assert
