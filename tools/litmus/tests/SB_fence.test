// Store buffering: fence.sc forbids both reads of zero, fence.acq_rel does not (§8.10.6).
.global x;
.global y;

d0.b0.t0 {
  st.relaxed.gpu [x], 1;
  fence.$0.gpu;
  ld.relaxed.gpu r0, [y];
}

d0.b1.t0 {
  st.relaxed.gpu [y], 1;
  fence.$0.gpu;
  ld.relaxed.gpu r1, [x];
}

$1 (r0 == 1 || r1 == 1) as sb;

$$
sc      | assert
acq_rel | check
