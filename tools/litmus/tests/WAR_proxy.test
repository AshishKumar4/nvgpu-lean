// Write after read across proxies, the reuse of a TMA ring slot: thread 0 reads x through the
// generic proxy, then releases; thread 1 acquires and writes x through another proxy. mixedproxy
// reaches a non-generic store only through a surface, i.e. a virtual alias, so the alias fence
// rows separate the alias from the proxy. Can the read return the later write? Alloy (ptx.als)
// and the Lean model: yes without a proxy fence (with or without the alias fence), no once a
// fence.proxy.surface precedes the surface store.
.global x;
.surfref c virtually aliases x;
.global flag;

d0.b0.t0 {
  ld.weak r0, [x];
  st.release.cta [flag], 1;
}

d0.b0.t1 {
  ld.acquire.cta r1, [flag] == 1;
  $0
  $1 [$2], 1;
}

$3 (r0 $4 1) as war;

$$
                                        | st   | x | assert | !=
                                        | sust | c | permit | ==
fence.proxy.alias;                      | sust | c | permit | ==
fence.proxy.surface;                    | sust | c | assert | !=
fence.proxy.alias; fence.proxy.surface; | sust | c | assert | !=
