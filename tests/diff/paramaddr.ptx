// A device function taking its parameter's address (PTX ISA 5.1.6.4: the parameter is copied onto the
// stack, its address local), compared between the PTX interpreter and the SASS simulator
// (Tests/SassDiff.lean). Thread t passes in[4t .. 4t+3] as a 16-byte parameter to `mix`, which
// reads word 0 through ld.param, takes the parameter's address, stores word 0 times 3 over word
// 2 through it, and returns the sum of words 1 to 3 read through it, xor word 0; out[2t] is the
// result, out[2t + 1] that of a second call with the words rotated.
.version 8.7
.target sm_90a
.address_size 64

.func (.param .b32 r) mix(.param .align 16 .b8 s[16])
{
  .reg .b32 w0, w1, w2, w3, x;
  .reg .b64 a;
  ld.param.u32 w0, [s];
  mov.u64 a, s;
  mul.lo.u32 x, w0, 3;
  st.local.u32 [a+8], x;
  ld.local.u32 w1, [a+4];
  ld.local.u32 w2, [a+8];
  ld.local.u32 w3, [a+12];
  add.u32 x, w1, w2;
  add.u32 x, x, w3;
  xor.b32 x, x, w0;
  st.param.b32 [r], x;
  ret;
}

.visible .entry paramaddr(.param .u64 out, .param .u64 in)
{
  .reg .b32 t, a0, a1, a2, a3, v;
  .reg .b64 o, x, rd;
  ld.param.u64 o, [out];
  ld.param.u64 x, [in];
  cvta.to.global.u64 o, o;
  cvta.to.global.u64 x, x;
  mov.u32 t, %tid.x;
  mul.wide.u32 rd, t, 16;
  add.s64 x, x, rd;
  ld.global.v4.u32 {a0, a1, a2, a3}, [x];
  mul.wide.u32 rd, t, 8;
  add.s64 o, o, rd;
  {
    .param .align 16 .b8 p[16];
    .param .b32 q;
    st.param.v4.b32 [p], {a0, a1, a2, a3};
    call (q), mix, (p);
    ld.param.b32 v, [q];
  }
  st.global.u32 [o], v;
  {
    .param .align 16 .b8 p[16];
    .param .b32 q;
    st.param.v4.b32 [p], {a1, a2, a3, a0};
    call (q), mix, (p);
    ld.param.b32 v, [q];
  }
  st.global.u32 [o+4], v;
  ret;
}
