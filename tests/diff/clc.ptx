// clusterlaunchcontrol.try_cancel (SASS UGETNEXTWORKID.SELFCAST and .BROADCAST) and query_cancel,
// compared between the PTX interpreter and the SASS simulator (Tests/SassDiff.lean): thread 0 of
// each CTA asks to cancel a cluster, its mbarrier expecting the 16-byte response, waits, and
// out[2c], out[2c + 1] are .is_canceled and the response's third word, for CTA c (the model's
// requests fail: 0, 0).
.version 8.8
.target sm_100a
.address_size 64

.visible .entry clc(.param .u64 out)
{
  .shared .align 16 .b8 resp[16];
  .shared .align 8 .b64 bar;
  .reg .b32 t, c, r1, r2, v, w;
  .reg .pred p, q, z;
  .reg .b64 o, d, st;
  .reg .b128 x;
  ld.param.u64 o, [out];
  cvta.to.global.u64 o, o;
  mov.u32 t, %tid.x;
  mov.u32 c, %ctaid.x;
  mov.u32 r1, resp;
  mov.u32 r2, bar;
  setp.eq.u32 z, t, 0;
  @!z bra done;
  mbarrier.init.shared::cta.b64 [r2], 1;
  fence.mbarrier_init.release.cluster;
  mbarrier.arrive.expect_tx.shared::cta.b64 st, [r2], 16;
  clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [r1], [r2];
w0:
  mbarrier.try_wait.parity.shared::cta.b64 q, [r2], 0;
  @!q bra w0;
  mbarrier.arrive.expect_tx.shared::cta.b64 st, [r2], 16;
  clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.multicast::cluster::all.b128 [r1], [r2];
w1:
  mbarrier.try_wait.parity.shared::cta.b64 q, [r2], 1;
  @!q bra w1;
  ld.shared.b128 x, [r1];
  clusterlaunchcontrol.query_cancel.is_canceled.pred.b128 p, x;
  selp.u32 v, 1, 0, p;
  ld.shared.u32 w, [r1+8];
  mul.wide.u32 d, c, 8;
  add.s64 d, o, d;
  st.global.u32 [d], v;
  st.global.u32 [d+4], w;
done:
  ret;
}
