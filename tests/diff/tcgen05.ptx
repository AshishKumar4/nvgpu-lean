// Tensor memory and one tcgen05.mma, compared between the PTX interpreter and the SASS simulator
// (Tests/SassDiff.lean), sm_100a. Each of the 128 threads writes row t of A (128 x 16 f16) and
// threads 0-63 row t of B (16 x 64, stored N-major), from `in`, into shared memory in the
// no-swizzle K-major layout (8-row by 16-byte core matrices; LBO 128, SBO 256); warp 0 allocates
// 128 columns; thread 0 issues the MMA into f32 D and commits it to an mbarrier. Each thread then
// stores to out[72 t ..]:
//   0-63   its row of D (tcgen05.ld.32x32b.x64);
//   64-67  after tcgen05.st.16x256b.x1 of D's first four words at column 64, tcgen05.ld.16x64b.x4
//          there (the two shapes' fragments differ);
//   68-69  after tcgen05.st.32x32b.x2.unpack::16b of words 4-5 at column 80, the low halves read
//          back by tcgen05.ld.32x32b.x2.pack::16b;
//   70-71  tcgen05.ld.16x32bx2.x2 at column 80 with the half-split offset 2.
.version 9.0
.target sm_100a
.address_size 64

.visible .entry tcgen05(.param .u64 out, .param .u64 in)
{
  .shared .align 1024 .b8 sa[4096];
  .shared .align 1024 .b8 sb[2048];
  .shared .align 8 .b64 bar;
  .shared .align 4 .b32 taddr;
  .reg .pred p, w0, q, en;
  .reg .b32 t, wp, k, off, v, a, b, ma, mt, d, row, col, idesc, x<72>;
  .reg .b64 ob, ib, rd, da, db, e;
  ld.param.u64 ob, [out];
  ld.param.u64 ib, [in];
  cvta.to.global.u64 ob, ob;
  cvta.to.global.u64 ib, ib;
  mov.u32 t, %tid.x;
  shr.u32 wp, t, 5;
  mov.u32 a, sa;
  mov.u32 b, sb;
  mov.u32 ma, bar;
  mov.u32 mt, taddr;
  // Row t of A: words in[8t .. 8t+7], two halves each, at (t/8)*256 + (k/8)*128 + (t%8)*16 + (k%8)*2.
  mov.u32 k, 0;
rowa:
  shr.u32 off, t, 3;
  shl.b32 off, off, 8;
  and.b32 v, t, 7;
  shl.b32 v, v, 4;
  add.u32 off, off, v;
  shr.u32 v, k, 3;
  shl.b32 v, v, 7;
  add.u32 off, off, v;
  and.b32 v, k, 7;
  shl.b32 v, v, 1;
  add.u32 off, off, v;
  shl.b32 v, t, 3;
  shr.u32 d, k, 1;
  add.u32 v, v, d;
  mul.wide.u32 e, v, 4;
  add.s64 rd, ib, e;
  ld.global.u32 v, [rd];
  add.u32 d, a, off;
  st.shared.u32 [d], v;
  setp.lt.u32 p, t, 64;
  @!p bra nextk;
  add.u32 d, b, off;
  add.s64 rd, rd, 4096;
  ld.global.u32 v, [rd];
  st.shared.u32 [d], v;
nextk:
  add.u32 k, k, 2;
  setp.lt.u32 q, k, 16;
  @q bra rowa;
  setp.eq.u32 w0, wp, 0;
  @w0 tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [mt], 128;
  @w0 tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
  setp.eq.u32 p, t, 0;
  @p mbarrier.init.shared::cta.b64 [ma], 1;
  fence.proxy.async.shared::cta;
  tcgen05.fence::before_thread_sync;
  bar.sync 0;
  tcgen05.fence::after_thread_sync;
  ld.shared.u32 d, [mt];
  @!p bra waitd;
  // Descriptors: start >> 4, LBO 128 >> 4 at bit 16, SBO 256 >> 4 at bit 32, version 1 at bit 46.
  cvt.u64.u32 da, a;
  shr.u64 da, da, 4;
  or.b64 da, da, 0x0000401000080000;
  cvt.u64.u32 db, b;
  shr.u64 db, db, 4;
  or.b64 db, db, 0x0000401000080000;
  // D f32 (bit 4), A and B f16, K-major, N = 64 (8 << 17), M = 128 (8 << 24).
  mov.u32 idesc, 0x08100010;
  setp.ne.u32 en, 0, 0;
  tcgen05.mma.cta_group::1.kind::f16 [d], da, db, idesc, en;
  tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [ma];
waitd:
  mbarrier.try_wait.parity.shared::cta.b64 q, [ma], 0;
  @!q bra waitd;
  tcgen05.fence::after_thread_sync;
  shl.b32 row, wp, 21;
  add.u32 row, row, d;
  tcgen05.ld.sync.aligned.32x32b.x64.b32 {x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31, x32, x33, x34, x35, x36, x37, x38, x39, x40, x41, x42, x43, x44, x45, x46, x47, x48, x49, x50, x51, x52, x53, x54, x55, x56, x57, x58, x59, x60, x61, x62, x63}, [row];
  tcgen05.wait::ld.sync.aligned;
  add.u32 col, row, 64;
  tcgen05.st.sync.aligned.16x256b.x1.b32 [col], {x0, x1, x2, x3};
  tcgen05.wait::st.sync.aligned;
  tcgen05.ld.sync.aligned.16x64b.x4.b32 {x64, x65, x66, x67}, [col];
  add.u32 col, row, 80;
  tcgen05.st.sync.aligned.32x32b.x2.unpack::16b.b32 [col], {x4, x5};
  tcgen05.wait::st.sync.aligned;
  tcgen05.ld.sync.aligned.32x32b.x2.pack::16b.b32 {x68, x69}, [col];
  tcgen05.ld.sync.aligned.16x32bx2.x2.b32 {x70, x71}, [col], 2;
  tcgen05.wait::ld.sync.aligned;
  mul.wide.u32 e, t, 288;
  add.s64 rd, ob, e;
  st.global.v4.b32 [rd], {x0, x1, x2, x3};
  st.global.v4.b32 [rd+16], {x4, x5, x6, x7};
  st.global.v4.b32 [rd+32], {x8, x9, x10, x11};
  st.global.v4.b32 [rd+48], {x12, x13, x14, x15};
  st.global.v4.b32 [rd+64], {x16, x17, x18, x19};
  st.global.v4.b32 [rd+80], {x20, x21, x22, x23};
  st.global.v4.b32 [rd+96], {x24, x25, x26, x27};
  st.global.v4.b32 [rd+112], {x28, x29, x30, x31};
  st.global.v4.b32 [rd+128], {x32, x33, x34, x35};
  st.global.v4.b32 [rd+144], {x36, x37, x38, x39};
  st.global.v4.b32 [rd+160], {x40, x41, x42, x43};
  st.global.v4.b32 [rd+176], {x44, x45, x46, x47};
  st.global.v4.b32 [rd+192], {x48, x49, x50, x51};
  st.global.v4.b32 [rd+208], {x52, x53, x54, x55};
  st.global.v4.b32 [rd+224], {x56, x57, x58, x59};
  st.global.v4.b32 [rd+240], {x60, x61, x62, x63};
  st.global.v4.b32 [rd+256], {x64, x65, x66, x67};
  st.global.v4.b32 [rd+272], {x68, x69, x70, x71};
  tcgen05.fence::before_thread_sync;
  bar.sync 0;
  @!w0 bra done;
  tcgen05.fence::after_thread_sync;
  tcgen05.dealloc.cta_group::1.sync.aligned.b32 d, 128;
done:
  ret;
}
