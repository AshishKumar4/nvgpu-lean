// tex.grad on a one-level texture, compared between the PTX interpreter and the SASS simulator
// (Tests/SassDiff.lean): as tex2d (tests/diff/tex.ptx), with gradients.
.version 9.0
.target sm_90a
.address_size 64

.visible .entry texgrad(.param .u64 out, .param .u64 in, .param .u64 tex)
{
  .reg .b32 t, a, b, r0, r1, r2, r3;
  .reg .f32 x, y, fa, fb, g;
  .reg .b64 o, h, d;
  ld.param.u64 o, [out];
  ld.param.u64 h, [tex];
  cvta.to.global.u64 o, o;
  mov.u32 t, %tid.x;
  rem.u32 a, t, 8;
  div.u32 b, t, 8;
  cvt.rn.f32.u32 fa, a;
  cvt.rn.f32.u32 fb, b;
  fma.rn.f32 x, fa, 0f3FB00000, 0fC0100000;
  fma.rn.f32 y, fb, 0f3F500000, 0fBF800000;
  mul.f32 g, fa, 0f3E800000;
  mul.wide.u32 d, t, 16;
  add.s64 o, o, d;
  tex.grad.2d.v4.f32.f32 {r0, r1, r2, r3}, [h, {x, y}], {g, fb}, {fb, g};
  st.global.v4.b32 [o], {r0, r1, r2, r3};
  ret;
}
