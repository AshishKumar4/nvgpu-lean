// Vector atomics and reductions (sm_90), .b128 exch/cas and .b16 cas, compared between the PTX
// interpreter and the SASS simulator (Tests/SassDiff.lean). Thread t works on its own 32 words of
// out (out[32t ...], initially arbitrary) with operands from in[16t ...]:
//   0-3   red.add.v4.f32                 4-5   atom.add.v2.f32, old values to 6-7
//   8-11  red.add.noftz.v4.f16x2         12-15 atom.max.noftz.v8.bf16, old values to 16-19
//   20-23 atom.exch.b128 then atom.cas.b128 (swapping), old values to 24-27
//   28    atom.cas.b16 on its low half, the old half to 29
.version 9.0
.target sm_90a
.address_size 64

.visible .entry vatom(.param .u64 out, .param .u64 in)
{
  .reg .b32 t, a<4>, h<4>, r<4>;
  .reg .f32 f<4>, g<2>;
  .reg .b16 c<8>, s0, s1, s2;
  .reg .b64 o, x, rd, lo, hi;
  .reg .b128 v, w, d;
  ld.param.u64 o, [out];
  ld.param.u64 x, [in];
  cvta.to.global.u64 o, o;
  cvta.to.global.u64 x, x;
  mov.u32 t, %tid.x;
  mul.wide.u32 rd, t, 128;
  add.s64 o, o, rd;
  mul.wide.u32 rd, t, 64;
  add.s64 x, x, rd;
  ld.global.v4.f32 {f0, f1, f2, f3}, [x];
  ld.global.v4.b32 {h0, h1, h2, h3}, [x+16];
  ld.global.v4.b32 {a0, a1, a2, a3}, [x+32];
  red.global.add.v4.f32 [o], {f0, f1, f2, f3};
  atom.global.add.v2.f32 {g0, g1}, [o+16], {f2, f3};
  st.global.v2.f32 [o+24], {g0, g1};
  red.global.add.noftz.v4.f16x2 [o+32], {h0, h1, h2, h3};
  mov.b32 {c0, c1}, a0;
  mov.b32 {c2, c3}, a1;
  mov.b32 {c4, c5}, a2;
  mov.b32 {c6, c7}, a3;
  atom.global.max.noftz.v8.bf16 {c0, c1, c2, c3, c4, c5, c6, c7}, [o+48], {c0, c1, c2, c3, c4, c5, c6, c7};
  mov.b32 r0, {c0, c1};
  mov.b32 r1, {c2, c3};
  mov.b32 r2, {c4, c5};
  mov.b32 r3, {c6, c7};
  st.global.v4.b32 [o+64], {r0, r1, r2, r3};
  mov.b64 lo, {h0, h1};
  mov.b64 hi, {a2, a3};
  mov.b128 v, {lo, hi};
  atom.global.exch.b128 d, [o+80], v;
  mov.b64 lo, {a0, a1};
  mov.b128 w, {lo, hi};
  atom.global.cas.b128 d, [o+80], v, w;
  mov.b128 {lo, hi}, d;
  st.global.v2.b64 [o+96], {lo, hi};
  mov.b32 {s0, s1}, h2;
  atom.global.cas.b16 s2, [o+112], s0, s1;
  cvt.u32.u16 r0, s2;
  st.global.u32 [o+116], r0;
  ret;
}
