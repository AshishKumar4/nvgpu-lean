// The sm_90 binary64 mma.sync shapes (DMMA.16x8x4/8/16), compared between the PTX interpreter
// and the SASS simulator (Tests/SassDiff.lean). Each thread loads A, B, C fragment doubles from
// in[16t..16t+15] (A: 8, B: 4, C: 4) and stores D to out[12t + k]:
//   0-3   m16n8k4          4-7   m16n8k8          8-11  m16n8k16
.version 9.0
.target sm_90a
.address_size 64

.visible .entry mmaf64(.param .u64 out, .param .u64 in)
{
  .reg .f64 a<8>, b<4>, c<4>, d<4>;
  .reg .b32 t;
  .reg .b64 o, x, rd;
  ld.param.u64 o, [out];
  ld.param.u64 x, [in];
  cvta.to.global.u64 o, o;
  cvta.to.global.u64 x, x;
  mov.u32 t, %laneid;
  mul.wide.u32 rd, t, 128;
  add.s64 x, x, rd;
  mul.wide.u32 rd, t, 96;
  add.s64 o, o, rd;
  ld.global.v2.f64 {a0, a1}, [x];
  ld.global.v2.f64 {a2, a3}, [x+16];
  ld.global.v2.f64 {a4, a5}, [x+32];
  ld.global.v2.f64 {a6, a7}, [x+48];
  ld.global.v2.f64 {b0, b1}, [x+64];
  ld.global.v2.f64 {b2, b3}, [x+80];
  ld.global.v2.f64 {c0, c1}, [x+96];
  ld.global.v2.f64 {c2, c3}, [x+112];
  mma.sync.aligned.m16n8k4.row.col.f64.f64.f64.f64 {d0, d1, d2, d3}, {a0, a1}, {b0}, {c0, c1, c2, c3};
  st.global.v2.f64 [o], {d0, d1};
  st.global.v2.f64 [o+16], {d2, d3};
  mma.sync.aligned.m16n8k8.row.col.f64.f64.f64.f64 {d0, d1, d2, d3}, {a0, a1, a2, a3}, {b0, b1}, {c0, c1, c2, c3};
  st.global.v2.f64 [o+32], {d0, d1};
  st.global.v2.f64 [o+48], {d2, d3};
  mma.sync.aligned.m16n8k16.row.col.f64.f64.f64.f64 {d0, d1, d2, d3}, {a0, a1, a2, a3, a4, a5, a6, a7}, {b0, b1, b2, b3}, {c0, c1, c2, c3};
  st.global.v2.f64 [o+64], {d0, d1};
  st.global.v2.f64 [o+80], {d2, d3};
  ret;
}
