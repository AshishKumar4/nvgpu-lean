  wmma.load.a.sync.aligned.row.m8n8k32.global.s4 {%a0}, [%p+0], 64;
  wmma.load.b.sync.aligned.col.m8n8k32.global.s4 {%b0}, [%p+256], 32;
  wmma.load.c.sync.aligned.row.m8n8k32.global.s32 {%c0, %c1}, [%p+512], 8;
  wmma.mma.sync.aligned.row.col.m8n8k32.s32.s4.s4.s32 {%d0, %d1}, {%a0}, {%b0}, {%c0, %c1};
  wmma.store.d.sync.aligned.row.m8n8k32.global.s32 [%o], {%d0, %d1}, 8;
  wmma.load.a.sync.aligned.row.m8n8k32.global.u4 {%a0}, [%p+0], 32;
  wmma.load.b.sync.aligned.col.m8n8k32.global.u4 {%b0}, [%p+256], 64;
  wmma.mma.sync.aligned.row.col.m8n8k32.satfinite.s32.u4.u4.s32 {%d0, %d1}, {%a0}, {%b0}, {%c0, %c1};
  wmma.store.d.sync.aligned.col.m8n8k32.global.s32 [%o+256], {%d0, %d1}, 8;
  wmma.load.a.sync.aligned.row.m8n8k128.global.b1 {%a0}, [%p+0], 128;
  wmma.load.b.sync.aligned.col.m8n8k128.global.b1 {%b0}, [%p+256], 256;
  wmma.mma.xor.popc.sync.aligned.row.col.m8n8k128.s32.b1.b1.s32 {%d0, %d1}, {%a0}, {%b0}, {%c0, %c1};
  wmma.store.d.sync.aligned.row.m8n8k128.global.s32 [%o+512], {%d0, %d1}, 8;
  wmma.mma.and.popc.sync.aligned.row.col.m8n8k128.s32.b1.b1.s32 {%d0, %d1}, {%a0}, {%b0}, {%c0, %c1};
  wmma.store.d.sync.aligned.row.m8n8k128.global.s32 [%o+768], {%d0, %d1}, 8;
  ret;
}
