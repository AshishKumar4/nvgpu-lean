// Sub-byte and single-bit WMMA (IMMA.8832, BMMA.88128): A row-major, B column-major,
// C and D row-major with strides.
.visible .entry wmma9(.param .u64 out, .param .u64 in) {
  .reg .b32 %a<1>, %b<1>, %c<2>, %d<2>;
  .reg .b64 %o, %p;
  ld.param.u64 %o, [out]; ld.param.u64 %p, [in];
