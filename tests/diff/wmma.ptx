// WMMA (wmma.load/mma/store) on every multiplicand type and shape family, compared word by word
// between the PTX interpreter and the SASS simulator (Tests/SassDiff.lean): kernel wmmaN loads
// A, B, C from in (A, then B, then C, each in its load's layout), and stores D = A*B + C
// column-major to out. The WMMA fragment layout: NV.PTX.Sem.Matrix.wfrag.
.version 9.0
.target sm_90a
.address_size 64

.visible .entry wmma0(.param .u64 out, .param .u64 in) {
  .reg .b32 %a<8>, %b<8>;
  .reg .b32 %c<8>, %d<8>;
  .reg .b64 %o, %p;
  ld.param.u64 %o, [out]; ld.param.u64 %p, [in];
  cvta.to.global.u64 %o, %o; cvta.to.global.u64 %p, %p;
  wmma.load.a.sync.aligned.row.m16n16k16.global.f16 {%a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7}, [%p+0];
  wmma.load.b.sync.aligned.col.m16n16k16.global.f16 {%b0, %b1, %b2, %b3, %b4, %b5, %b6, %b7}, [%p+512];
  wmma.load.c.sync.aligned.row.m16n16k16.global.f32 {%c0, %c1, %c2, %c3, %c4, %c5, %c6, %c7}, [%p+1024];
  wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32 {%d0, %d1, %d2, %d3, %d4, %d5, %d6, %d7}, {%a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7}, {%b0, %b1, %b2, %b3, %b4, %b5, %b6, %b7}, {%c0, %c1, %c2, %c3, %c4, %c5, %c6, %c7};
  wmma.store.d.sync.aligned.col.m16n16k16.global.f32 [%o], {%d0, %d1, %d2, %d3, %d4, %d5, %d6, %d7}, 16;
  ret;
}

