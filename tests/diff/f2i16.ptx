// Binary32 to 16-bit integers (tests/diff/f2i16.ptx), compared word by word between the PTX
// interpreter and the SASS simulator (Tests/SassDiff.lean): thread t converts in[t] to s16 and u16,
// rounded to nearest and toward zero, saturating, each widened back to 32 bits. ptxas folds a
// signed widening into the conversion (`F2I.S16` sign-extends into its register).
.version 9.0
.target sm_90a
.address_size 64

.visible .entry f2i16(.param .u64 out, .param .u64 in)
{
  .reg .f32 a;
  .reg .b16 h;
  .reg .b32 t, r;
  .reg .b64 o, x, rd;
  ld.param.u64 o, [out];
  ld.param.u64 x, [in];
  cvta.to.global.u64 o, o;
  cvta.to.global.u64 x, x;
  mov.u32 t, %tid.x;
  mul.wide.u32 rd, t, 4;
  add.s64 x, x, rd;
  ld.global.f32 a, [x];
  mul.wide.u32 rd, t, 16;
  add.s64 o, o, rd;
  cvt.rni.s16.f32 h, a;
  cvt.s32.s16 r, h;
  st.global.u32 [o], r;
  cvt.rzi.s16.f32 h, a;
  cvt.s32.s16 r, h;
  st.global.u32 [o+4], r;
  cvt.rni.u16.f32 h, a;
  cvt.u32.u16 r, h;
  st.global.u32 [o+8], r;
  cvt.rzi.u16.f32 h, a;
  cvt.u32.u16 r, h;
  st.global.u32 [o+12], r;
  ret;
}
