// Integer minimum and maximum, packed and with .relu, and saturating sums, compared between the PTX interpreter and the
// SASS simulator (Tests/SassDiff.lean): in[2t], in[2t+1] = a, b; out[10t + k]:
//   0 min.u16x2  1 max.u16x2  2 min.s16x2  3 max.s16x2  4 min.relu.s16x2  5 max.relu.s16x2
//   6 min.relu.s32  7 max.relu.s32  8 add.sat.s32  9 sub.sat.s32
.version 8.7
.target sm_90a
.address_size 64

.visible .entry vmnmx(.param .u64 out, .param .u64 in)
{
  .reg .b32 a, b, r, t;
  .reg .b64 o, x, rd;
  ld.param.u64 o, [out];
  ld.param.u64 x, [in];
  cvta.to.global.u64 o, o;
  cvta.to.global.u64 x, x;
  mov.u32 t, %tid.x;
  mul.wide.u32 rd, t, 8;
  add.s64 x, x, rd;
  ld.global.u32 a, [x];
  ld.global.u32 b, [x+4];
  mul.wide.u32 rd, t, 40;
  add.s64 o, o, rd;
  min.u16x2 r, a, b;
  st.global.u32 [o], r;
  max.u16x2 r, a, b;
  st.global.u32 [o+4], r;
  min.s16x2 r, a, b;
  st.global.u32 [o+8], r;
  max.s16x2 r, a, b;
  st.global.u32 [o+12], r;
  min.relu.s16x2 r, a, b;
  st.global.u32 [o+16], r;
  max.relu.s16x2 r, a, b;
  st.global.u32 [o+20], r;
  min.relu.s32 r, a, b;
  st.global.u32 [o+24], r;
  max.relu.s32 r, a, b;
  st.global.u32 [o+28], r;
  add.sat.s32 r, a, b;
  st.global.u32 [o+32], r;
  sub.sat.s32 r, a, b;
  st.global.u32 [o+36], r;
  ret;
}
