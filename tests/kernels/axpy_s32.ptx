// y[i] = a * x[i] + y[i] over n 32-bit integers, one thread per element.
.version 9.0
.target sm_90a
.address_size 64

.visible .entry axpy_s32(.param .u64 x, .param .u64 y, .param .u32 a, .param .u32 n)
{
  .reg .pred %p<2>;
  .reg .b32 %r<10>;
  .reg .b64 %rd<8>;
  ld.param.u64 %rd1, [x];
  ld.param.u64 %rd2, [y];
  ld.param.u32 %r1, [a];
  ld.param.u32 %r2, [n];
  mov.u32 %r3, %ctaid.x;
  mov.u32 %r4, %ntid.x;
  mov.u32 %r5, %tid.x;
  mad.lo.s32 %r6, %r3, %r4, %r5;
  setp.ge.s32 %p1, %r6, %r2;
  @%p1 bra DONE;
  cvta.to.global.u64 %rd3, %rd1;
  cvta.to.global.u64 %rd4, %rd2;
  mul.wide.s32 %rd5, %r6, 4;
  add.s64 %rd6, %rd3, %rd5;
  add.s64 %rd7, %rd4, %rd5;
  ld.global.u32 %r7, [%rd6];
  ld.global.u32 %r8, [%rd7];
  mad.lo.s32 %r9, %r1, %r7, %r8;
  st.global.u32 [%rd7], %r9;
DONE:
  ret;
}
