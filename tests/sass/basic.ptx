.version 8.8
.target sm_90a
.address_size 64

.visible .entry vadd(.param .u64 pa, .param .u64 pb, .param .u64 pc, .param .u32 n)
{
  .reg .pred p;
  .reg .b32 r<6>;
  .reg .f32 f<4>;
  .reg .b64 rd<10>;
  ld.param.u64 rd1, [pa];
  ld.param.u64 rd2, [pb];
  ld.param.u64 rd3, [pc];
  ld.param.u32 r1, [n];
  mov.u32 r2, %ctaid.x;
  mov.u32 r3, %ntid.x;
  mov.u32 r4, %tid.x;
  mad.lo.s32 r5, r2, r3, r4;
  setp.ge.u32 p, r5, r1;
  @p bra DONE;
  cvta.to.global.u64 rd4, rd1;
  cvta.to.global.u64 rd5, rd2;
  cvta.to.global.u64 rd6, rd3;
  mul.wide.u32 rd7, r5, 4;
  add.s64 rd8, rd4, rd7;
  ld.global.f32 f1, [rd8];
  add.s64 rd8, rd5, rd7;
  ld.global.f32 f2, [rd8];
  fma.rn.f32 f3, f1, f2, f1;
  add.s64 rd9, rd6, rd7;
  st.global.f32 [rd9], f3;
DONE:
  ret;
}

.visible .entry red(.param .u64 pa, .param .u64 pout)
{
  .reg .pred p<3>;
  .reg .b32 r<12>;
  .reg .f32 f<6>;
  .reg .b64 rd<8>;
  .shared .align 4 .f32 sm[256];
  ld.param.u64 rd1, [pa];
  ld.param.u64 rd2, [pout];
  mov.u32 r1, %tid.x;
  mov.u32 r2, %ctaid.x;
  mad.lo.s32 r3, r2, 256, r1;
  cvta.to.global.u64 rd3, rd1;
  mul.wide.u32 rd4, r3, 4;
  add.s64 rd5, rd3, rd4;
  ld.global.f32 f1, [rd5];
  shfl.sync.bfly.b32 f2, f1, 16, 31, -1;
  add.f32 f1, f1, f2;
  shfl.sync.bfly.b32 f2, f1, 8, 31, -1;
  add.f32 f1, f1, f2;
  and.b32 r4, r1, 31;
  setp.ne.u32 p1, r4, 0;
  @p1 bra SKIP;
  shr.u32 r5, r1, 5;
  mov.u32 r6, sm;
  shl.b32 r7, r5, 2;
  add.u32 r8, r6, r7;
  st.shared.f32 [r8], f1;
SKIP:
  bar.sync 0;
  setp.ne.u32 p2, r1, 0;
  @p2 bra END;
  mov.u32 r9, 0;
  mov.f32 f3, 0f00000000;
  mov.u32 r6, sm;
LOOP:
  ld.shared.f32 f4, [r6];
  add.f32 f3, f3, f4;
  add.u32 r6, r6, 4;
  add.u32 r9, r9, 1;
  setp.lt.u32 p0, r9, 8;
  @p0 bra LOOP;
  cvta.to.global.u64 rd6, rd2;
  mul.wide.u32 rd7, r2, 4;
  add.s64 rd6, rd6, rd7;
  atom.global.add.f32 f5, [rd6], f3;
END:
  ret;
}
