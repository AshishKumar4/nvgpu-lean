// Warp votes into registers and their readers (VOTE.ANY's register result read by BREV and by
// VIADD); nvcc 13.0.88's PTX of:
//   unsigned b = __ballot_sync(~0u, in[t] > 3); o[t] = __brev(b);
//   unsigned c = __ballot_sync(~0u, in[t + 32] > 1); o[t + 32] = c + 7;

.version 9.0
.target sm_90a
.address_size 64

	// .globl	vote

.visible .entry vote(
	.param .u64 vote_param_0,
	.param .u64 vote_param_1
)
{
	.reg .pred 	%p<5>;
	.reg .b32 	%r<9>;
	.reg .b64 	%rd<8>;

	ld.param.u64 	%rd1, [vote_param_0];
	ld.param.u64 	%rd2, [vote_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r1, %tid.x;
	mul.wide.s32 	%rd5, %r1, 4;
	add.s64 	%rd6, %rd4, %rd5;
	ld.global.u32 	%r2, [%rd6];
	setp.gt.s32 	%p1, %r2, 3;
	mov.u32 	%r3, -1;
	vote.sync.ballot.b32 	%r4, %p1, %r3;
	brev.b32 	%r5, %r4;
	add.s64 	%rd7, %rd3, %rd5;
	st.global.u32 	[%rd7], %r5;
	ld.global.u32 	%r6, [%rd6+128];
	setp.gt.s32 	%p3, %r6, 1;
	vote.sync.ballot.b32 	%r7, %p3, %r3;
	add.s32 	%r8, %r7, 7;
	st.global.u32 	[%rd7+128], %r8;
	ret;

}

