	cvta.to.global.u64 	%rd2, %rd1;
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, %ctaid.x;
	mad.lo.s32 	%r3, %r2, 128, %r1;
	mul.wide.s32 	%rd3, %r3, 4;
	add.s64 	%rd4, %rd2, %rd3;
	ld.global.nc.v4.f32 	{%f1, %f2, %f3, %f4}, [%rd4+-16];
	setp.lt.s32 	%p1|%p2, %r3, 1000;
	@!%p1 bra 	$L__BB0_2;
	fma.rn.f32 	%f5, %f1, 0f3F800000, %f2;
	add.f64 	%fd1, 0d3FF0000000000000, 0d0000000000000000;
	mov.b32 	%r4, (1 << 4) + (WARP_SZ - 1) * 2;
	mov.u64 	%rd5, bar_+8;
	selp.b32 	%r5, 1, 0, !%p2;
$L__BB0_2:
	{
	.reg .b32 inner;
	mov.b32 inner, -1;
	}
	shfl.sync.bfly.b32 	%r6|%p3, %r5, 16, 31, -1;
	vote.sync.ballot.b32 	%r7, %p1, 0xffffffff;
	mbarrier.arrive.expect_tx.shared::cta.b64 	_, [mbar], 1024;
	cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [smem], [%rd1, {%r1, %r2}], [mbar];
	wgmma.mma_async.sync.aligned.m64n8k16.f32.bf16.bf16 {%f1, %f2, %f3, %f4}, %rd5, %rd6, %p1, 1, 1, 0, 1;
	vadd.s32.u32.s32.sat 	%r8, %r1.b0, %r2.h1, %r3;
	{ // callseq 0
	.param .b32 param0;
