.global .attribute(.managed) .s32 g;
.const .f32 blur[3] = {.05, 0.1, 5e-2};

.func (.param .b32 ret) add1 (.param .b32 x) .noreturn;

.visible .func (.param .b32 r) add2 (.param .b32 x, .reg .u32 y)
{
	.reg .b32 %t<2>;
	ld.param.b32 %t0, [x];
	add.s32 %t1, %t0, y;
	st.param.b32 [r], %t1;
