// Labels scoped by block (Tests/Sched.lean): two blocks each define DONE, as copies of the same
// inline assembly do. The first block's branch must reach its own DONE: out[0] = 11. Labels
// resolved across blocks send it to the second block's DONE instead, and out[0] = 0.
.version 8.8
.target sm_90a
.address_size 64

.visible .entry labels(.param .u64 out)
{
  .reg .b32 v;
  .reg .b64 o;
  ld.param.u64 o, [out];
  cvta.to.global.u64 o, o;
  mov.u32 v, 0;
  {
    .reg .pred P;
    setp.eq.u32 P, v, 0;
    @P bra DONE;
    add.u32 v, v, 100;
    DONE:
  }
  add.u32 v, v, 1;
  {
    .reg .pred P;
    setp.eq.u32 P, v, 7;
    @P bra DONE;
    add.u32 v, v, 10;
    DONE:
  }
  st.global.u32 [o], v;
  ret;
}
