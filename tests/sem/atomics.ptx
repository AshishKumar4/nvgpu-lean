// Global atomics; checked by Tests/SassSem.lean.
.version 9.0
.target sm_90a
.address_size 64

// Each thread takes a ticket: out[ticket] = tid, so out is a permutation and ctr ends at the thread
// count. ctr[1] gets max(tid * 37 % 128); ctr[2] counts by CAS; ctr[4..5] sums tid as 64-bit.
.visible .entry tickets(.param .u64 out, .param .u64 ctr)
{
  .reg .pred p;
  .reg .b32 t, n, v, old, new, seen;
  .reg .b64 rd<8>, big;
  ld.param.u64 rd1, [out];
  ld.param.u64 rd2, [ctr];
  cvta.to.global.u64 rd1, rd1;
  cvta.to.global.u64 rd2, rd2;
  mov.u32 t, %tid.x;
  mov.u32 v, %ctaid.x;
  mov.u32 n, %ntid.x;
  mad.lo.u32 t, v, n, t;
  atom.global.add.u32 v, [rd2], 1;
  mul.wide.u32 rd3, v, 4;
  add.s64 rd4, rd1, rd3;
  st.global.u32 [rd4], t;
  mul.lo.u32 v, t, 37;
  and.b32 v, v, 127;
  atom.global.max.u32 old, [rd2+4], v;
  ld.global.u32 old, [rd2+8];
CAS:
  add.u32 new, old, 1;
  atom.global.cas.b32 seen, [rd2+8], old, new;
  setp.ne.u32 p, seen, old;
  mov.u32 old, seen;
  @p bra CAS;
  cvt.u64.u32 big, t;
  red.global.add.u64 [rd2+16], big;
  ret;
}
