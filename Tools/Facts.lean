import NV.Arch.Parts
import NV.Core.Roles
import NV.Bounds.Machine
import Lean.Data.Json

/-!
`lake exe facts [--check]`: print each part's facts table to `docs/facts-<part>.md` from the
`Params` values, so the tables cannot drift from the model, and the same facts as data to
`docs/facts-<part>.json` (`json`): every fact with its kind, source and role, the opcode table's
timings, and the per-cycle resources the bounds use (`NV.Bounds.Part`), for programs that read the
device rather than a person. With `--check`, write nothing and fail
if a table is stale, or if a fact cites a source key missing from `docs/sources.md`, a published
measurement does not name the part it was measured on, or a part names two facts alike.
-/

open NV NV.Arch NV.Core


/-- One line: whitespace runs become one space, and the table's separator is escaped. -/
def cell (s : String) : String := Id.run do
  let mut out := ""
  let mut space := false
  for c in s.toList do
    if c.isWhitespace then
      space := true
    else
      if space && !out.isEmpty then out := out.push ' '
      out := out ++ (if c == '|' then "\\|" else c.toString)
      space := false
  return out

def kindCell (r : Row) : String :=
  r.kind.name ++ match r.measuredOn with
    | some part => s!" ({part})"
    | none => ""

def markdown (key : String) (p : Params) : String := Id.run do
  let mut out := s!"# {p.name}: facts\n\n" ++
    s!"Generated by `lake exe facts` from the part's parameter set (`NV/Arch/`, registered in " ++
    "`NV/Arch/Parts.lean`); do not edit. Kinds and sources: `NV/Fact.lean`, `docs/sources.md`. " ++
    "A kind followed by a part was measured on that part. Cycles are SM cycles.\n"
  out := out ++ "The role column says who reads a fact (`NV/Core/Roles.lean`): only `engine` " ++
    "facts change a simulated run of one GPU, `mesh` facts a mesh's collective times.\n"
  for (title, rows) in sections p do
    out := out ++ s!"\n## {title}\n\n" ++
      "| fact | value | kind | role | source | note |\n|---|---|---|---|---|---|\n"
    for r in rows do
      let role := if r.name.startsWith "ops." then "engine" else (roleOf r.name).text
      out := out ++ s!"| `{r.name}` | {cell r.value} | {kindCell r} | {role} | `{r.source.ref}` " ++
        s!"{cell r.source.loc} | {cell r.note} |\n"
  return out

open Lean (Json) in
/-- A part's facts as data (`docs/facts-<part>.json`): its identity; each fact of the table, with
`number` when the value is a natural number; the opcode table's timings; and its resources, each
with its instances and per-instance rate (`units` every `cycles` SM cycles) and the facts that
rate rests on. -/
def json (key : String) (p : Params) : Json := Id.run do
  let str (s : String) : Json := Json.str s
  let nat (n : Nat) : Json := (n : Json)
  let src (s : Source) : Json := Json.mkObj [("ref", str s.ref), ("loc", str s.loc)]
  let facts : Array Json := ((sections p).flatMap fun (title, rows) => rows.map fun r =>
    let role := if r.name.startsWith "ops." then "engine" else (roleOf r.name).text
    Json.mkObj ([("section", str title), ("name", str r.name), ("value", str r.value)] ++
      (match r.value.toNat? with | some n => [("number", nat n)] | none => []) ++
      [("kind", str r.kind.name), ("measuredOn", match r.measuredOn with | some m => str m | none => Json.null),
       ("role", str role), ("source", src r.source), ("note", str (cell r.note))])).toArray
  let ops : Array Json := p.ops.map fun r =>
    let t := r.timing.value
    Json.mkObj [("opcode", str r.opcode), ("mods", Json.arr (r.mods.map str)),
      ("pipe", str (toString (repr t.pipe))), ("interval", nat t.interval), ("latency", nat t.latency),
      ("readRelease", nat t.readRelease), ("lateRead", nat t.lateRead), ("guardLatency", nat t.guardLatency),
      ("kind", str r.timing.kind.name), ("source", src r.timing.source)]
  let resource (r : NV.Bounds.Resource) : Json :=
    Json.mkObj [("name", str r.name), ("unit", str r.unit), ("instances", nat r.capacity.instances),
      ("units", nat r.capacity.rate.units), ("cycles", nat r.capacity.rate.cycles),
      ("facts", Json.arr (r.facts.map (str ·.name)).toArray), ("note", str (cell r.note))]
  let pipe (r : NV.Bounds.PipeResource) : Json :=
    Json.mkObj [("name", str r.name), ("unit", str r.unit), ("instances", nat r.instances),
      ("units", nat 1), ("cycles", nat r.interval),
      ("facts", Json.arr (r.facts.map (str ·.name)).toArray), ("note", str (cell r.note))]
  let resources : Array Json :=
    #[resource (NV.Bounds.Part.dram p), resource (NV.Bounds.Part.l2 p), resource (NV.Bounds.Part.smIn p),
      resource (NV.Bounds.Part.gpcIn p), resource (NV.Bounds.Part.l1 p), resource (NV.Bounds.Part.tma p), pipe (NV.Bounds.Part.issue p)] ++
    (p.ops.map (·.opcode)).toList.eraseDups.toArray.map (pipe <| NV.Bounds.Part.pipeOf p ·)
  return Json.mkObj [("part", str key), ("name", str p.name), ("clockMHz", nat p.clockMHz.value),
    ("sms", nat p.sms.value), ("smsps", nat p.smsps.value),
    ("generatedBy", str "lake exe facts, from NV/Arch (do not edit)"),
    ("facts", Json.arr facts), ("ops", Json.arr ops), ("resources", Json.arr resources)]

/-- Every second element: the backquoted words of a string split at its backquotes. -/
def odds {α : Type} : List α → List α
  | _ :: b :: rest => b :: odds rest
  | _ => []

/-- The keys `docs/sources.md` defines: backquoted words in the first cell of its table rows. -/
def sourceKeys (text : String) : List String :=
  (text.splitOn "\n").flatMap fun line =>
    if line.startsWith "| `" then odds (((line.splitOn "|")[1]?.getD "").splitOn "`") else []

#guard sourceKeys "| key | source |\n|---|---|\n| `a`, `b` | x `c` |\n| `d` | y |" ==
  ["a", "b", "d"]

def problems (keys : List String) (key : String) (p : Params) : List String := Id.run do
  let mut errs := []
  let rows := rows p
  for r in rows do
    let at_ := s!"{key} {r.name}"
    unless keys.contains r.source.ref do errs := errs ++ [s!"{at_}: unknown source {r.source.ref}"]
    if r.kind == .measured && !r.source.ref.startsWith "meas" then
      errs := errs ++ [s!"{at_}: a measurement of ours cites {r.source.ref}"]
    if r.kind == .published && r.measuredOn.isNone then
      errs := errs ++ [s!"{at_}: a published measurement must name the part it was measured on"]
  let names := rows.map (·.name)
  for n in names.eraseDups do
    if names.count n > 1 then errs := errs ++ [s!"{key}: two facts named {n}"]
  return errs

def main (args : List String) : IO UInt32 := do
  let check := args == ["--check"]
  unless check || args.isEmpty do
    IO.eprintln "usage: facts [--check]"; return 2
  let keys := sourceKeys (← IO.FS.readFile "docs/sources.md")
  let mut failed := false
  for (key, p) in NV.Arch.parts do
    for e in problems keys key p do
      IO.eprintln e; failed := true
    for (path, text) in [(s!"docs/facts-{key}.md", markdown key p),
                         (s!"docs/facts-{key}.json", (json key p).pretty ++ "\n")] do
      if check then
        let current ← if (← System.FilePath.pathExists path) then IO.FS.readFile path else pure ""
        if current != text then
          IO.eprintln s!"{path} is stale: run lake exe facts"; failed := true
      else
        IO.FS.writeFile path text
  return if failed then 1 else 0
