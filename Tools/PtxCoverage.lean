import NV.PTX.Interp
import NV.PTX.Syntax.Check

/-!
`lake exe ptx-coverage [--doc]`: every PTX instruction (`NV.PTX.Op.all`, the PTX ISA 9.x list) by
target — whether `sm_80`, `sm_90a` and `sm_120a` have it (`Op.requires`, the ISA's Target ISA
Notes) and whether the semantics defines it. Each instruction is probed through the dispatch
itself (`NV.PTX.Async.exec?`, then `Step.exec`): an instruction the thread semantics does not
model says so, any other outcome (an operand error on the empty probe) means it is modelled, so
the table cannot drift from the code. `--doc` prints `docs/ptx-coverage.md`.
-/

open NV.PTX NV.PTX.Sem NV.PTX.Check

/-- `thread`, `async`, `out of scope` or none: which part of the semantics defines `op`, or that
it is outside the model by design. -/
def modelled (op : Op) : Option String :=
  let pi : PInstr := { guard := none, i := { op, quals := [], types := [], args := #[] },
                       args := #[], line := 0 }
  let e : Sem.Env := default
  let t : Thread := default
  match NV.PTX.Async.exec? e t pi with
  | some _ => some "async"
  | none =>
    match Step.exec e t pi with
    | .error m =>
      if (m.splitOn "is not modelled by the thread semantics").length > 1 then none
      else if (m.splitOn "outside the model").length > 1 then some "out of scope"
      else some "thread"
    | .ok _ => some "thread"

def targets : List (String × Arch) :=
  [("sm_80", ⟨80, none⟩), ("sm_90a", ⟨90, some 'a'⟩), ("sm_120a", ⟨120, some 'a'⟩)]

def main (args : List String) : IO UInt32 := do
  let rows := Op.all.map fun op => (op, Check.Op.requires op, modelled op)
  if args.contains "--doc" then
    IO.println "# PTX coverage by target"
    IO.println ""
    IO.println "Generated by `.lake/build/bin/ptx-coverage --doc`; not edited by hand. Every PTX ISA 9.x"
    IO.println "instruction: the target it needs (Target ISA Notes; `a`: architecture-specific), whether"
    IO.println "each target has it, and the part of the semantics that defines it (probed through the"
    IO.println "dispatch itself). ✓ modelled, ✗ the target has it and the semantics does not, ○ outside the"
    IO.println "model by design (textures and surfaces, fabric memory, multimem), · the target lacks it."
    IO.println ""
    IO.println "| instruction | needs | sm_80 | sm_90a | sm_120a | semantics |"
    IO.println "|---|---|---|---|---|---|"
  let mut missing : Array String := #[]
  for (op, req, m) in rows do
    let needs := match req with
      | some (sm, a) => s!"sm_{sm}{if a then "a" else ""}"
      | none => ""
    let cells := targets.map fun (_, a) =>
      if !(Check.Arch.has a op) then "·" else if m == some "out of scope" then "○"
      else if m.isSome then "✓" else "✗"
    if m.isNone && cells.contains "✗" then missing := missing.push op.spelling
    if args.contains "--doc" then
      IO.println s!"| `{op.spelling}` | {needs} | {" | ".intercalate cells} | {m.getD "—"} |"
  if args.contains "--doc" then
    IO.println ""
    IO.println s!"{rows.length} instructions; {missing.size} that a target has and the semantics does not model."
  else
    IO.println s!"{rows.length} instructions; not modelled on a target that has them ({missing.size}):"
    IO.println s!"  {" ".intercalate missing.toList}"
  return 0
