import NV.SASS.Sem
import NV.SASS.Read
import NV.SASS.Opcodes
import NV.Arch.Parts

/-!
`lake exe sass-coverage [--doc]`: every opcode of NVIDIA's instruction-set table for each target's
family (`NV.SASS.catalogue`: CUDA Binary Utilities §4.3) — whether the semantics defines it and
whether the target's part has a timing class for it. The semantics is probed through
`NV.SASS.decode` itself on every form of the opcode in the target's listings (`no semantics yet`
or `unsupported form`: not defined). `--doc` prints `docs/sass-coverage.md`
(`tools/sass/coverage.sh` gathers the listings).
-/

open NV NV.SASS

def plainEnv : Env :=
  { ctx := { ntid := (128, 1, 1), nctaid := (1, 1, 1), ctaid := (0, 0, 0), warp := 0,
             threads := 128 },
    const0 := Store.empty 0 4096 }

/-- Whether the semantics defines the outcome of `op` on a plain warp at its own pc: not
`no semantics yet` nor `unsupported form`. -/
def defined (op : Op) (pc : Nat) : Bool :=
  match op.outOf plainEnv { Warp.init 256 32 with conv := some pc } fullMask with
  | .fault m => (m.splitOn "no semantics yet").length == 1 && (m.splitOn "unsupported form").length == 1
  | _ => true

/-- A table name (`UIADD3.64`) as an instruction: its opcode and modifiers. -/
def bare (name : String) : Instr :=
  match name.splitOn "." with
  | op :: mods => { pc := 0, opcode := op, mods := mods.toArray, ctrl := default }
  | [] => { pc := 0, opcode := name, ctrl := default }

/-- Every instruction of the listings (`NAME.sass` with `NAME.elf`) in `dir`, each with whether
the semantics defines it in its own kernel. -/
def corpus (dir : System.FilePath) : IO (Array (Instr × Bool)) := do
  let mut out := #[]
  for e in ← dir.readDir do
    if e.path.extension != some "sass" then continue
    let elf := e.path.withExtension "elf"
    unless ← elf.pathExists do continue
    if let .ok ks := NV.SASS.Read.kernels (← IO.FS.readFile e.path) (← IO.FS.readFile elf) then
      for k in ks do
        let ops := decode k
        for pc in [0:k.code.size] do out := out.push (k.code[pc]!, defined ops[pc]! pc)
  return out

def targets : List (String × Nat × String × String) :=
  [("sm_80", 80, "a100-40", "tests/sass/sm_80"), ("sm_90a", 90, "h200", "tests/sass"),
   ("sm_100a", 100, "b200", "tests/sass/sm_100a"), ("sm_120a", 120, "rtxpro6000", "tests/sass/sm_120a")]

/-- How an opcode stands on a target: every form of it in the listings is defined (`some true`),
one is not (`some false`), or no listing has it (`none`). -/
def status (code : Array (Instr × Bool)) (name : String) : Option Bool × Option Instr :=
  let b := bare name
  let uses := code.filter fun (i, _) => i.opcode == b.opcode && b.mods.all i.mods.contains
  if uses.isEmpty then (none, none) else (some (uses.all (·.2)), uses[0]?.map (·.1))

def main (args : List String) : IO UInt32 := do
  let doc := args.contains "--doc"
  -- `TARGET=DIR`: more listings for a target.
  let extra := args.filterMap fun a => match a.splitOn "=" with
    | [t, d] => some (t, d)
    | _ => none
  if doc then
    IO.println "# SASS coverage by target"
    IO.println ""
    IO.println "Generated by `.lake/build/bin/sass-coverage --doc TARGET=DIR…` (`tools/sass/coverage.sh`);"
    IO.println "not edited by hand. Every opcode of NVIDIA's instruction-set table for the target's family"
    IO.println "(CUDA Binary Utilities v13.5, §4.3), judged on the compiled listings for the target: the"
    IO.println "test fixtures, the differential kernels and cuda-samples, compiled for it. Semantics: ✓ every"
    IO.println "form in those listings is defined (`NV.SASS.decode`), ✗ one is not, · no listing contains"
    IO.println "the opcode (NVIDIA's table is the family's: legacy names no longer compiled, data-center"
    IO.println "opcodes, forms of PTX the corpus does not use). Timing: the target's part has a class for"
    IO.println "the first form seen (or the bare opcode). Texture and surface opcodes beyond the forms"
    IO.println "`decodeTex` lists are outside the model."
  for (name, sm, part, dir) in targets do
    let some p := NV.Arch.parts.lookup part | continue
    let ops := (catalogue sm).value
    let mut code ← corpus dir
    for (t, d) in extra do
      if t == name then code := code ++ (← corpus d)
    let rows := ops.map fun o =>
      let (st, first) := status code o.name
      (o, st, (p.timing (first.getD (bare o.name))).isSome)
    let seen := rows.filter (·.2.1.isSome) |>.length
    let sem := rows.filter (·.2.1 == some true) |>.length
    let missing := rows.filter (·.2.1 == some false) |>.map (·.1.name)
    if doc then
      IO.println ""
      IO.println s!"## {name} ({part}): {ops.length} opcodes, {seen} in the listings, {sem} of them defined"
      IO.println ""
      IO.println "| opcode | class | semantics | timing | NVIDIA's description |"
      IO.println "|---|---|---|---|---|"
      for (o, st, t) in rows do
        let sc := match st with | some true => "✓" | some false => "✗" | none => "·"
        let cls := ((repr o.cls).pretty.splitOn ".").getLast!
        IO.println s!"| `{o.name}` | {cls} | {sc} | {if t then "✓" else "—"} | {o.what} |"
    else
      IO.println s!"{name}: {ops.length} opcodes, {seen} in the listings, {sem} defined"
      IO.println s!"  undefined: {" ".intercalate missing}"
      let forms := (code.filter fun (i, ok) => !ok && missing.contains i.opcode).map (·.1.full)
      for f in forms.foldl (fun acc f => if acc.contains f then acc else acc.push f) #[] do
        IO.println s!"    {f}"
  return 0
